{
  "name": "jarvis",
  "version": "0.8.0",
  "private": true,
  "description": "J.A.R.V.I.S. — a universal operating environment for AI-agent software development.",
  "scripts": {
    "dev": "pnpm --filter @jarvis/desktop dev",
    "tauri": "pnpm --filter @jarvis/desktop tauri",
    "build": "pnpm --filter @jarvis/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test && cd apps/desktop/src-tauri && cargo test",
    "docs": "pnpm --filter @jarvis/docs build",
    "docs:serve": "pnpm --filter @jarvis/docs serve",
    "docs:test": "pnpm --filter @jarvis/docs test"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  }
}
