{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:Path = \"$env:USERPROFILE\\.cargo\\bin;$env:Path\"; pnpm.cmd tauri dev"
      ],
      "port": 5273,
      "autoPort": false
    },
    {
      "name": "desktop-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@jarvis/desktop", "dev"],
      "port": 5273
    }
  ]
}
